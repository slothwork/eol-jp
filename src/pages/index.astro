---
import HomeDeadlineChanges from '@/components/HomeDeadlineChanges.astro';
import HomeCategories from '@/components/HomeCategories.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DeadlineTable from '@/components/DeadlineTable.astro';
import ProductCard from '@/components/ProductCard.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import attentionRankingData from '@/data/eol-attention-ranking.json';
import { featuredProducts, generatedAt, products, recentlyEnded, statusFor, upcomingReleases } from '@/lib/eol';
import { formatJaDate, relativeEol } from '@/lib/date';

type AttentionRankingSnapshot = {
  generatedAt: string | null;
  periodStart: string | null;
  periodEnd: string | null;
  windowDays: number;
  scopeDays: number;
  source: string;
  items: Array<{ slug: string; pageViews: number }>;
};

const attentionRanking = attentionRankingData as AttentionRankingSnapshot;
const upcoming90 = upcomingReleases(90);
const upcoming180 = upcomingReleases(180);
const upcoming365 = upcomingReleases(365);
const ended = recentlyEnded(90);
const featured = featuredProducts().slice(0, 9);
const updated = new Date(generatedAt).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo', dateStyle: 'long', timeStyle: 'short' });

const upcomingByProduct = new Map<string, (typeof upcoming180)[number]>();
for (const item of upcoming180) {
  if (!upcomingByProduct.has(item.product.slug)) upcomingByProduct.set(item.product.slug, item);
}

const attentionItems = attentionRanking.items.flatMap((ranking) => {
  const upcoming = upcomingByProduct.get(ranking.slug);
  return upcoming ? [{ ...ranking, ...upcoming }] : [];
});
const attentionUpdated = attentionRanking.generatedAt
  ? new Date(attentionRanking.generatedAt).toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' })
  : null;
---
<BaseLayout title="EOL情報.jp" description="ソフトウェア、OS、データベース、フレームワークのEOL・サポート終了日を日本語で分かりやすく確認できます。">
  <section class="hero">
    <div class="container">
      <span class="eyebrow">END OF LIFE / SUPPORT LIFECYCLE</span>
      <h1>「このバージョン、いつまで使える？」を日本語ですぐ確認。</h1>
      <p>EOL（End of Life）やセキュリティサポート終了を、日付だけでなく「あと何日か」まで分かりやすく表示します。</p>
      <div class="hero-actions">
        <a class="button primary" href="/eol/">製品を検索する</a>
        <a class="button" href="/releases/">最新リリースを見る</a>
        <a class="button" href="/upcoming/">まもなくEOLを見る</a>
      </div>
      <div class="stats">
        <div class="stat"><strong>{products.length}</strong><span>掲載製品</span></div>
        <div class="stat"><strong>{upcoming90.length}</strong><span>90日以内にEOL</span></div>
        <div class="stat"><strong>{upcoming365.length}</strong><span>1年以内にEOL</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>まもなくEOL</h2>
      <p class="section-lead">期限が近いものから表示しています。移行・更新計画の優先順位付けに利用できます。</p>
      <DeadlineTable items={upcoming365.slice(0, 8)} ariaLabel="まもなくEOLを迎える製品" />
      <p><a href="/upcoming/">今後1年のEOLをすべて見る →</a></p>
    </div>
  </section>

  <HomeDeadlineChanges />

  {attentionItems.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>注目されているEOL情報</h2>
        <p class="section-lead">
          {attentionRanking.scopeDays}日以内にEOLを迎える製品のうち、直近{attentionRanking.windowDays}日間に当サイトで閲覧された回数が多い順です。製品の普及率や人気度を示すものではありません。
        </p>
        <div class="attention-list">
          {attentionItems.map(({ product, release, pageViews }, index) => (
            <div class="attention-row">
              <div class="attention-rank" aria-label={`${index + 1}位`}>{index + 1}</div>
              <div>
                <strong><a href={`/eol/${product.slug}/`}>{product.label}</a></strong>
                <div class="muted">バージョン {release.name} · {formatJaDate(release.eolFrom)}</div>
              </div>
              <div><StatusBadge status={statusFor(release)} /></div>
              <div>{relativeEol(release.eolFrom)}</div>
              <div class="attention-views">{pageViews.toLocaleString('ja-JP')} 閲覧</div>
            </div>
          ))}
        </div>
        <p class="section-note">Cloudflare Web Analyticsによるページ閲覧数を集計。{attentionUpdated ? `最終集計：${attentionUpdated}` : ''}</p>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <h2>主要製品から探す</h2>
      <p class="section-lead">EOL確認の入口として、主要な開発・インフラ製品を優先表示しています。</p>
      <div class="grid">{featured.map((product) => <ProductCard product={product} />)}</div>
      <HomeCategories />
    </div>
  </section>

  {ended.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>最近EOLになったバージョン</h2>
        <DeadlineTable items={ended.slice(0, 5)} ariaLabel="最近EOLになったバージョン" />
      </div>
    </section>
  )}


  <section class="section" aria-labelledby="home-eol-guide">
    <div class="container">
      <h2 id="home-eol-guide">EOL・サポート期限をどう読む？</h2>
      <p class="section-lead">EOLという言葉が指す終了の範囲は製品によって異なります。日付と一緒に対象バージョン・サポート区分を確認してください。</p>
      <div class="grid">
        <article class="panel">
          <h3>EOLは一律の「利用禁止日」ではありません</h3>
          <p>EOL（End of Life）は製品・バージョンのライフサイクル上の終了を表す言葉です。終了する保守内容や継続利用の条件は、ベンダーの方針によって異なります。</p>
        </article>
        <article class="panel">
          <h3>通常サポートとセキュリティサポート</h3>
          <p>不具合修正や機能改善の提供終了と、セキュリティ修正の提供終了が別の日になる場合があります。利用中のエディションやサポート契約も含め、公式情報で確認してください。</p>
        </article>
        <article class="panel">
          <h3>「あと何日」は準備の目安</h3>
          <p>残日数は影響調査や移行テストを始める目安です。期限当日の更新を前提とせず、必要な作業と余裕を見込んで計画してください。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="home-next-steps">
    <div class="container">
      <h2 id="home-next-steps">期限を確認した後の3ステップ</h2>
      <p class="section-lead">日付だけで判断せず、対象の一致と公式情報を確かめ、必要な製品を継続して管理します。</p>
      <div class="grid">
        <article class="panel">
          <h3>1. 利用中のバージョンを特定する</h3>
          <p>実際に使っている製品・バージョンを確かめ、掲載されているリリースと照合します。同じ製品名でもエディションや配布元によって条件が異なる場合があります。</p>
          <p><a href="/eol/">製品一覧から探す →</a></p>
        </article>
        <article class="panel">
          <h3>2. 公式のサポート条件を確認する</h3>
          <p>サポート区分、延長サポートの有無、更新時の条件をベンダー・公式プロジェクトの情報で確認します。当サイトでは公式ソースの確認と日付の照合を区別しています。</p>
          <p><a href="/trust/official-sources/">公式ソース照合状況を見る →</a></p>
        </article>
        <article class="panel">
          <h3>3. 必要な製品は継続して見直す</h3>
          <p>移行予定や次回の確認日を決め、管理対象の製品をマイEOLでまとめて確認できます。重要な更新判断では、その時点の公式情報も確認してください。</p>
          <p><a href="/my-eol/">マイEOLで管理する →</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="home-data-sources">
    <div class="container notice">
      <h2 id="home-data-sources">掲載情報の根拠と更新について</h2>
      <p>ライフサイクル情報は endoflife.date API を基礎データとして利用し、表示用に正規化しています。主要製品には独自の日本語説明や公式情報への導線も用意しています。</p>
      <p>公式ソースの確認と掲載日付の照合は別々に管理しており、すべての製品で日付の一致を確認済みという意味ではありません。重要な判断ではベンダー・公式プロジェクトの最新情報を優先してください。</p>
      <p><strong>データ更新：</strong> {updated}。<a href="/about/">出典と免責事項 →</a>　<a href="/trust/official-sources/">公式ソース照合状況 →</a>　<a href="/trust/audit-log/">変更監査ログ →</a></p>
    </div>
  </section>
</BaseLayout>
