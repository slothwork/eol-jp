---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { generatedAt, getCategoryLabel, getProductMigrationGuide, getProductSeoDescription, getProductSeoTitle, getProductSummary, nearestUpcomingEol, products, recommendedTarget, statusFor } from '@/lib/eol';
import { isIndexableProduct } from '@/lib/index-policy';
import { formatJaDate, relativeEol } from '@/lib/date';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const INITIAL_RELEASE_LIMIT = 20;
const { product } = Astro.props;
const releases = product.releases.slice().sort((a, b) => (b.releaseDate ?? '').localeCompare(a.releaseDate ?? ''));
const hiddenReleaseCount = Math.max(0, releases.length - INITIAL_RELEASE_LIMIT);
const canonicalPath = `/eol/${product.slug}/`;
const title = getProductSeoTitle(product);
const description = getProductSeoDescription(product);
const categoryLabel = getCategoryLabel(product.category);
const indexable = isIndexableProduct(product);
const nearestEol = nearestUpcomingEol(product);
const target = nearestEol ? recommendedTarget(product, nearestEol) : null;
const migrationGuide = getProductMigrationGuide(product);
const supported = releases.filter((release) => statusFor(release) !== 'ended');
const ended = releases.filter((release) => statusFor(release) === 'ended');
const siteBase = Astro.site ?? Astro.url.origin;
const pageUrl = new URL(canonicalPath, siteBase).toString();
const faq = [
  {
    q: `${product.label} のEOLはいつですか？`,
    a: nearestEol
      ? `${product.label} ${nearestEol.name} は ${formatJaDate(nearestEol.eolFrom)} が、現在確認できるサポート中系列の中で最も近いEOL予定です。製品やリリース系列ごとに期限が異なるため、上の一覧と公式サポート方針を確認してください。`
      : `現在のスナップショットでは、${product.label} のサポート中バージョンについて将来のEOL日を特定できません。期限が未定の系列もあるため、公式サポート方針も確認してください。`
  },
  {
    q: `${product.label} のEOL後も使えますか？`,
    a: '技術的に動作し続ける場合はありますが、通常はセキュリティ修正や不具合修正の提供が終了または縮小します。継続利用する場合は、リスクを確認したうえで更新計画を立ててください。'
  },
  {
    q: `${product.label} はどのバージョンへ更新すればよいですか？`,
    a: target
      ? `このサイトでは、現在の系列より新しくサポート中と確認できる${target.isLts ? ' LTS' : ''} ${target.name} 系を移行候補として表示しています。ただし、実際の移行先は互換性、依存関係、LTS方針、ベンダーの移行ガイドを確認して決定してください。`
      : '移行先を一律には決められません。公式のサポート方針、互換性情報、依存関係を確認してサポート中のバージョンを選んでください。'
  }
];
const structured = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      inLanguage: 'ja-JP',
      dateModified: generatedAt,
      about: {
        '@type': 'Thing',
        name: product.label
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', siteBase).toString() },
        { '@type': 'ListItem', position: 2, name: '製品一覧', item: new URL('/eol/', siteBase).toString() },
        { '@type': 'ListItem', position: 3, name: product.label, item: pageUrl }
      ]
    }
  ]
};
---
<BaseLayout title={title} description={description} canonicalPath={canonicalPath} noindex={!indexable}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structured)}></script>
  <section class="page-head"><div class="container">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">ホーム</a><span>/</span><a href="/eol/">製品一覧</a><span>/</span><span aria-current="page">{product.label}</span>
    </nav>
    <span class="eyebrow">{categoryLabel}</span>
    <h1>{product.label} のEOL・サポート期限</h1>
    <p>{getProductSummary(product)}</p>
  </div></section>

  <section class="section"><div class="container two-col">
    <div>
      <h2>バージョン別サポート状況</h2>
      <div class="table-wrap"><table id="version-support-table">
        <thead><tr><th>バージョン</th><th>状態</th><th>リリース日</th><th>通常サポート</th><th>EOL / セキュリティ終了</th><th>最新</th></tr></thead>
        <tbody>
          {releases.map((release, index) => (
            <tr hidden={index >= INITIAL_RELEASE_LIMIT} data-version-extra={index >= INITIAL_RELEASE_LIMIT ? '' : undefined}>
              <td><strong>{release.name}</strong>{release.isLts && <><br/><span class="eyebrow">LTS</span></>}</td>
              <td><StatusBadge status={statusFor(release)} /><br/><small>{relativeEol(release.eolFrom)}</small></td>
              <td>{formatJaDate(release.releaseDate)}</td>
              <td>{formatJaDate(release.eoasFrom)}</td>
              <td><strong>{formatJaDate(release.eolFrom)}</strong></td>
              <td>{release.latest?.name ?? '不明'}{release.latest?.date && <><br/><small>{formatJaDate(release.latest.date)}</small></>}</td>
            </tr>
          ))}
        </tbody>
      </table></div>
      {hiddenReleaseCount > 0 && (
        <>
          <p class="section-note">最新 {INITIAL_RELEASE_LIMIT} 件を表示しています。全 {releases.length} 件。</p>
          <div class="hero-actions">
            <button
              class="button"
              type="button"
              data-version-more
              aria-expanded="false"
              aria-controls="version-support-table"
            >
              MORE（残り {hiddenReleaseCount} 件）
            </button>
          </div>
        </>
      )}

      {supported.length > 0 && (
        <section class="subsection">
          <h2>現在サポート中の主なバージョン</h2>
          <div class="version-list">
            {supported.slice(0, 8).map((release) => (
              <article class="version-item">
                <h3>{product.label} {release.name}</h3>
                <p>EOL: <strong>{formatJaDate(release.eolFrom)}</strong>（{relativeEol(release.eolFrom)}）</p>
                <p class="muted">最新リリース: {release.latest?.name ?? '不明'}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      {ended.length > 0 && (
        <section class="subsection">
          <h2>EOL済みの主なバージョン</h2>
          <p class="section-lead">EOL済みバージョンは、原則として新しい保守対象バージョンへの移行を検討してください。</p>
          <ul class="compact-list">
            {ended.slice(0, 8).map((release) => <li>{product.label} {release.name} — {formatJaDate(release.eolFrom)}</li>)}
          </ul>
        </section>
      )}
    </div>
    <aside class="panel">
      <h2>どうすればいい？</h2>
      {nearestEol ? (
        <>
          <p><strong>{product.label} {nearestEol.name}</strong> は、現在確認できるサポート中系列の中で最もEOLが近く、{relativeEol(nearestEol.eolFrom)} です。</p>
          {target && <p>更新先の候補として、現在の系列より新しくサポート中の {target.isLts && <strong>LTS </strong>}<strong>{target.name}</strong> 系を確認してください。公式の移行手順・互換性情報を確認してから判断してください。</p>}
        </>
      ) : <p>現在のスナップショットでは、将来のEOL日が確定しているサポート中バージョンを特定できません。期限未定の系列を含め、公式のサポート方針を確認してください。</p>}
      <p class="warning-box">このサイトは移行作業の安全性を保証するものではありません。本番更新前に公式ドキュメント、破壊的変更、依存パッケージの互換性を確認してください。</p>
      {product.versionCommand && <><h3>現在のバージョン確認</h3><div class="code">{product.versionCommand}</div></>}
      {migrationGuide && <>
        <h3>公式の移行・アップグレード資料</h3>
        <p><a href={migrationGuide.url} rel="external">{migrationGuide.label} →</a></p>
        {migrationGuide.note && <p class="muted">{migrationGuide.note}</p>}
      </>}
      <h3>一次情報</h3>
      <ul>
        {product.links.releasePolicy && <li><a href={product.links.releasePolicy} rel="external">公式リリース / サポート方針</a></li>}
        {product.links.html && <li><a href={product.links.html} rel="external">endoflife.date の {product.label} ページ</a></li>}
        <li><a href={`/changes/?product=${product.slug}`}>{product.label} の変更履歴</a></li>
      </ul>
    </aside>
  </div></section>

  <section class="section"><div class="container">
    <h2>{product.label} のEOLに関するよくある質問</h2>
    <div class="faq-list">
      {faq.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div></section>

  <section class="section"><div class="container">
    <h2>EOLとは？</h2>
    <p>EOL（End of Life）は、そのバージョンに対する通常の保守・修正・セキュリティ更新などが終了する節目です。製品によって「Active Support」「Security Support」「Maintenance Support」など段階が異なるため、実際の運用では公式のサポート方針も合わせて確認してください。</p>
  </div></section>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-version-more]').forEach((button) => {
      button.addEventListener('click', () => {
        document.querySelectorAll<HTMLTableRowElement>('[data-version-extra]').forEach((row) => {
          row.hidden = false;
        });
        button.setAttribute('aria-expanded', 'true');
        button.hidden = true;
      });
    });
  </script>
</BaseLayout>
