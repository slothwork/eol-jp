---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DeadlineTable from '@/components/DeadlineTable.astro';
import { statusFor, upcomingReleases } from '@/lib/eol';
import { formatJaDate, relativeEol } from '@/lib/date';

const items = upcomingReleases(365);
const priorityItems = items.filter(({ release }) => statusFor(release) !== 'supported');
const supportedItems = items
  .filter(({ release }) => statusFor(release) === 'supported')
  .map(({ product, release }) => ({
    productLabel: product.label,
    productSlug: product.slug,
    version: release.name,
    isLts: release.isLts,
    relative: relativeEol(release.eolFrom),
    date: formatJaDate(release.eolFrom)
  }));
const supportedItemsJson = JSON.stringify(supportedItems).replace(/</g, '\\u003c');
---
<BaseLayout title="今後1年のEOL・サポート終了予定" description="今後30日、90日、180日、1年以内にEOLを迎えるソフトウェアやOSを期限順に確認できます。">
  <section class="page-head"><div class="container">
    <h1>今後1年のEOL予定</h1>
    <p>初期表示では180日以内にEOLを迎えるものを期限順に表示します。181日〜1年以内の「サポート中」は必要なときだけ表示できます。</p>
    <div class="hero-actions">
      <a class="button" href="/upcoming/30-days/">30日以内</a>
      <a class="button" href="/upcoming/90-days/">90日以内</a>
      <a class="button" href="/upcoming/180-days/">180日以内</a>
      {supportedItems.length > 0 && (
        <button id="toggle-supported" class="button" type="button" data-count={supportedItems.length} aria-expanded="false" aria-controls="supported-eol-list">
          サポート中も表示（{supportedItems.length}件）
        </button>
      )}
    </div>
  </div></section>
  <section class="section"><div class="container">
    <DeadlineTable items={priorityItems} ariaLabel="今後1年のうち優先確認が必要なEOL一覧" />
    <DeadlineTable
      items={[]}
      ariaLabel="今後1年のサポート中EOL一覧"
      wrapperId="supported-eol-list"
      tbodyId="supported-eol-body"
      hidden
    />
  </div></section>
  <script id="supported-eol-data" type="application/json" is:inline set:html={supportedItemsJson}></script>
  <script>
    const toggle = document.querySelector<HTMLButtonElement>('#toggle-supported');
    const table = document.querySelector<HTMLElement>('#supported-eol-list');
    const body = document.querySelector<HTMLTableSectionElement>('#supported-eol-body');
    const dataElement = document.querySelector<HTMLScriptElement>('#supported-eol-data');
    let rendered = false;

    function renderSupportedItems() {
      if (rendered || !body || !dataElement) return;
      const items = JSON.parse(dataElement.textContent ?? '[]') as Array<{
        productLabel: string;
        productSlug: string;
        version: string;
        isLts: boolean;
        relative: string;
        date: string;
      }>;

      const fragment = document.createDocumentFragment();
      items.forEach((item) => {
        const row = document.createElement('tr');
        row.dataset.deadlineRow = '';

        const product = document.createElement('td');
        product.className = 'deadline-table-product';
        const strong = document.createElement('strong');
        const link = document.createElement('a');
        link.href = `/eol/${encodeURIComponent(item.productSlug)}/`;
        link.textContent = item.productLabel;
        strong.append(link);
        product.append(strong);

        const version = document.createElement('td');
        version.className = 'deadline-table-version';
        const versionStrong = document.createElement('strong');
        versionStrong.textContent = item.version;
        version.append(versionStrong);
        if (item.isLts) {
          const lts = document.createElement('span');
          lts.className = 'dense-table-inline-note';
          lts.textContent = 'LTS';
          version.append(lts);
        }

        const status = document.createElement('td');
        status.className = 'deadline-table-status';
        const badge = document.createElement('span');
        badge.className = 'status-badge status-supported';
        badge.textContent = 'サポート中';
        status.append(badge);

        const relative = document.createElement('td');
        relative.className = 'deadline-table-relative';
        const relativeStrong = document.createElement('strong');
        relativeStrong.textContent = item.relative;
        relative.append(relativeStrong);

        const date = document.createElement('td');
        date.className = 'deadline-table-date';
        date.textContent = item.date;

        row.append(product, version, status, relative, date);
        fragment.append(row);
      });
      body.append(fragment);
      rendered = true;
    }

    toggle?.addEventListener('click', () => {
      if (!table) return;
      const shouldShow = table.hidden;
      if (shouldShow) renderSupportedItems();
      table.hidden = !shouldShow;
      toggle.setAttribute('aria-expanded', String(shouldShow));
      const count = toggle.dataset.count ?? '0';
      toggle.textContent = shouldShow ? 'サポート中を隠す' : `サポート中も表示（${count}件）`;
    });
  </script>
</BaseLayout>
