---
import '@/styles.css';
import '@/external-notifications.css';
import ExternalNotificationSettings from '@/components/ExternalNotificationSettings.astro';
import EmailNotificationSettings from '@/components/EmailNotificationSettings.astro';
import RecentViewedProducts from '@/components/RecentViewedProducts.astro';
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
}
const { title, description, canonicalPath = Astro.url.pathname, noindex = false } = Astro.props;
const siteName = 'EOL情報.jp';
const siteBase = Astro.site ?? Astro.url.origin;
const canonical = new URL(canonicalPath, siteBase).toString();
const ogImage = new URL('/og-default.png', siteBase).toString();
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const showExternalNotificationSettings = canonicalPath === '/my-eol/';
const showRecentViewedProducts = canonicalPath === '/eol/' || canonicalPath === '/my-eol/';
const productHistorySlug = canonicalPath.match(/^\/eol\/([^/]+)\/$/)?.[1] ?? null;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#2457d6" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="EOL情報.jp - ソフトウェアのサポート終了日を日本語で確認" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="EOL情報.jp - ソフトウェアのサポート終了日を日本語で確認" />
    <title>{fullTitle}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      url: Astro.site?.toString() ?? canonical,
      image: ogImage,
      inLanguage: 'ja-JP',
      description: 'ソフトウェアやOSのEOL・サポート終了日を日本語で確認できるサイト'
    })}></script>
  </head>
  <body>
    <header class="site-header" data-site-header>
      <div class="container nav-wrap">
        <a class="brand" href="/">EOL情報.jp</a>
        <button
          class="mobile-nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-main-nav"
          data-menu-toggle
        >
          <span>メニュー</span>
          <span class="mobile-nav-icon" aria-hidden="true">☰</span>
        </button>
        <nav id="site-main-nav" class="main-nav" aria-label="メインナビゲーション" data-main-nav>
          <a href="/eol/">製品一覧</a>
          <a href="/upcoming/">まもなくEOL</a>
          <a href="/calendar/">カレンダー</a>
          <a href="/my-eol/">マイEOL</a>
          <a href="/changes/">変更履歴</a>
          <a href="/about/">このサイトについて</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
      {showRecentViewedProducts && <RecentViewedProducts />}
      {productHistorySlug && <span hidden data-view-history-recorder data-product-slug={productHistorySlug}></span>}
      {showExternalNotificationSettings && (
        <section class="section external-notification-section">
          <div class="container">
            <ExternalNotificationSettings />
            <EmailNotificationSettings />
          </div>
        </section>
      )}
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <strong>EOL情報.jp</strong>
          <p>ソフトウェアのサポート終了を、日本語で分かりやすく。</p>
          <p class="copyright">© Slothwright</p>
        </div>
        <div>
          <p>ライフサイクルデータの一部は <a href="https://endoflife.date/" rel="external">endoflife.date</a> を利用しています。</p>
          <nav class="footer-links" aria-label="フッターナビゲーション">
            <a href="/about/">データ出典・免責事項</a>
            <a href="/trust/official-sources/">公式ソース照合状況</a>
            <a href="/trust/audit-log/">変更監査ログ</a>
            <a href="/changes/">変更履歴</a>
            <a href="/api/">公開API</a>
            <a href="/my-eol/github-import/">GitHubから検出</a>
            <a href="/feed.xml">RSS</a>
            <a href="/calendar.ics">iCalendar</a>
          </nav>
        </div>
      </div>
    </footer>

    <button id="back-to-top" class="back-to-top" type="button" aria-label="ページの一番上に戻る" title="一番上に戻る" hidden>↑</button>
    <script>
      import {
        VIEW_HISTORY_STORAGE_KEY,
        parseViewHistory,
        recordViewedProduct,
        serializeViewHistory
      } from '@/lib/view-history';

      const historyRecorder = document.querySelector<HTMLElement>('[data-view-history-recorder]');
      if (historyRecorder) {
        const slug = historyRecorder.dataset.productSlug ?? '';
        const breadcrumbCurrent = document.querySelector<HTMLElement>('main .breadcrumb [aria-current="page"]');
        const pageHeading = document.querySelector<HTMLElement>('main .page-head h1');
        const headingText = pageHeading?.textContent?.trim() ?? '';
        const headingSuffix = ' のEOL・サポート期限';
        const fallbackLabel = headingText.endsWith(headingSuffix)
          ? headingText.slice(0, -headingSuffix.length)
          : slug;
        const label = breadcrumbCurrent?.textContent?.trim() || fallbackLabel;

        if (slug && label) {
          try {
            const current = parseViewHistory(localStorage.getItem(VIEW_HISTORY_STORAGE_KEY));
            const next = recordViewedProduct(current, slug, label);
            localStorage.setItem(VIEW_HISTORY_STORAGE_KEY, serializeViewHistory(next));
          } catch {
            // 履歴保存不可でも製品ページの閲覧は妨げない。
          }
        }
      }

      const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const mainNav = document.querySelector<HTMLElement>('[data-main-nav]');
      const desktopMenu = window.matchMedia('(min-width: 621px)');

      const setMenuOpen = (open: boolean) => {
        if (!menuToggle || !mainNav) return;
        menuToggle.setAttribute('aria-expanded', String(open));
        mainNav.dataset.open = String(open);
        const icon = menuToggle.querySelector<HTMLElement>('.mobile-nav-icon');
        if (icon) icon.textContent = open ? '×' : '☰';
      };

      menuToggle?.addEventListener('click', () => {
        setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true');
      });

      mainNav?.addEventListener('click', (event) => {
        if ((event.target as Element | null)?.closest('a')) setMenuOpen(false);
      });

      document.addEventListener('click', (event) => {
        if (menuToggle?.getAttribute('aria-expanded') !== 'true') return;
        if (event.target instanceof Node && siteHeader?.contains(event.target)) return;
        setMenuOpen(false);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || menuToggle?.getAttribute('aria-expanded') !== 'true') return;
        setMenuOpen(false);
        menuToggle?.focus();
      });

      desktopMenu.addEventListener('change', (event) => {
        if (event.matches) setMenuOpen(false);
      });

      const backToTop = document.querySelector<HTMLButtonElement>('#back-to-top');
      let ticking = false;

      const updateBackToTop = () => {
        if (backToTop) backToTop.hidden = window.scrollY < 640;
        ticking = false;
      };

      window.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateBackToTop);
      }, { passive: true });

      backToTop?.addEventListener('click', () => {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
      });

      updateBackToTop();
    </script>
  </body>
</html>
