---
import type { JapanCommercialSupport } from '@/data/japan-commercial-support';
import { formatJaDate } from '@/lib/date';

interface Props {
  support: JapanCommercialSupport;
}

const { support } = Astro.props;
---
<section class="subsection" id="commercial-support-jp">
  <h2>日本で利用できる商用サポート</h2>
  <p class="section-lead">EOL後の移行猶予や企業向け保守が必要な場合に確認できる、ベンダー公式の有償サポート情報です。料金・対象バージョン・SLAは契約時点の最新条件を必ず確認してください。</p>
  <div class="notice">
    <span class="eyebrow">COMMERCIAL SUPPORT</span>
    <h3>{support.service}</h3>
    <p><strong>提供:</strong> {support.provider}</p>
    <p>{support.summary}</p>
    <ul class="compact-list">
      {support.details.map((detail) => <li>{detail}</li>)}
    </ul>
    {support.caveat && <p class="warning-box">{support.caveat}</p>}
    <p>
      {support.sources.map((source, index) => (
        <>
          {index > 0 && <br/>}
          <a href={source.url} rel="external">{source.label} →</a>
        </>
      ))}
    </p>
    <p class="muted">公式情報確認日: {formatJaDate(support.checkedAt)}</p>
  </div>
</section>
