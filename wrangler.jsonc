{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eol-jp",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/notifications/*"]
  },
  "triggers": {
    "crons": ["15 1 * * *"]
  }
}
