{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eol-jp",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/notifications/*",
      "/api/v1/*",
      "/badge/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "NOTIFICATION_SUBSCRIPTIONS",
      "id": "ee50aa2917ec4cdeae0f644f3b3bee23"
    }
  ],
  "triggers": {
    "crons": ["15 1 * * *"]
  }
}
